{
  // ---------------------------------------------------------------------
  // Interpreter
  // ---------------------------------------------------------------------
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.terminal.useEnvFile": true,

  // ---------------------------------------------------------------------
  // Analysis
  //
  // The virtual environment holds ~8,400 files. Without these, Pylance and
  // the file watcher crawl over all of them and VS Code appears to freeze.
  // ---------------------------------------------------------------------
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/dist/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.ruff_cache/**"
  ],

  // ---------------------------------------------------------------------
  // File watching
  //
  // files.exclude only hides files in the Explorer. files.watcherExclude is
  // what actually stops VS Code watching them - without it, every change in
  // .venv re-triggers the extension host.
  // ---------------------------------------------------------------------
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/*.pyc": true
  },
  "files.exclude": {
    "**/.venv": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },

  // ---------------------------------------------------------------------
  // Terminal
  // ---------------------------------------------------------------------
  "terminal.integrated.enablePersistentSessions": true,
  "terminal.integrated.confirmOnExit": false,
  "terminal.integrated.hideExitAlert": true,
  "terminal.integrated.inheritEnv": true,

  // ---------------------------------------------------------------------
  // Testing
  // ---------------------------------------------------------------------
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,

  // ---------------------------------------------------------------------
  // Files
  // ---------------------------------------------------------------------
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.autoGuessEncoding": false,

  // .env holds the API keys and the model routing. An editor buffer that
  // auto-saves over a newer file on disk silently reverts it, so keep
  // auto-save off for it and revert the file after editing it elsewhere.
  "[.env]": {
    "files.autoSave": "off"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  }
}
