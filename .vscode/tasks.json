{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test: everything (db + models + pipeline)",
      "type": "shell",
      "command": "python main.py --test --warehouse WH-NORTH",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "test: pytest",
      "type": "shell",
      "command": "python -m pytest",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "db: check the connection",
      "type": "shell",
      "command": "python db/setup.py --check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "db: set up (schema + demo data)",
      "type": "shell",
      "command": "python db/setup.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "db: rebuild the combined .sql files",
      "type": "shell",
      "command": "python db/setup.py --emit-sql --dialect sqlite",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
