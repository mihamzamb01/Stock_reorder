# ===========================================================================
# Your API keys - fill these in and save.
#
# This project talks to any OpenAI-compatible gateway. Right now it is set up
# for LarpRouter (https://larprouter.com):
#
#   1. Sign in and create a workspace
#   2. Generate a key - they start with "lrsk-"
#   3. Put it in LARP_ROUTER_API_KEY below
#   4. Make sure the key is bound to a DeepSeek or GLM model pool
#      (the "Model pools" section of the LarpRouter dashboard)
#
# Then check it works with:  python main.py --preflight
# ===========================================================================

LARP_ROUTER_API_KEY=


# ---------------------------------------------------------------------------
# Keeping the other providers around
# ---------------------------------------------------------------------------
# They are optional. Set a key here and switch a role over with
# MODEL_<ROLE>_PROVIDER=openrouter / nvidia in the routing section below.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=


# ---------------------------------------------------------------------------
# A key for any other OpenAI-compatible platform
# ---------------------------------------------------------------------------
# LLM_API_KEY is the global fallback: if a role has no key of its own, this
# one is used. Point PROVIDER_BASE_URL at the platform's endpoint.
LLM_API_KEY=
# PROVIDER_BASE_URL=https://your-gateway.example.com/v1


# ===========================================================================
# Database
# ===========================================================================
# Supabase (Postgres). Paste the password between the colons below.
#
#   The username MUST be "postgres.<PROJECT_REF>" for the pooler - plain
#   "postgres" fails with "no tenant identifier provided".
#
#   The scheme must be "postgresql+psycopg://" so SQLAlchemy picks the psycopg3
#   driver.
#
# If your password has characters like @ # ! &, build the URL with the helper
# instead of hand-editing:
#
#   python db/setup.py --supabase <PROJECT_REF> <PASSWORD> --pooler --region <region>
#
# Then verify the connection:
#   python db/setup.py --check
#
# For local SQLite instead, comment the line above and use:
# DATABASE_URL=sqlite:///./stock_reorder.db
DATABASE_URL=postgresql+psycopg://postgres.wquynuvexpwmpjobbiec:PASTE_PASSWORD_HERE@aws-0-eu-west-1.pooler.supabase.com:6543/postgres


# ===========================================================================
# Model routing - one model per agent role
# ===========================================================================
#   MODEL_<ROLE>_PROVIDER    openrouter | nvidia | larprouter | custom
#   MODEL_<ROLE>_NAME        the provider's own model id
#   MODEL_<ROLE>_BASE_URL    override the endpoint for this role
#   MODEL_<ROLE>_KEY_ENV     which env var holds this role's key
#   MODEL_<ROLE>_API_KEY     put the key here instead of a shared variable
#   MODEL_<ROLE>_TEMPERATURE optional, blank = provider default
#   MODEL_<ROLE>_MAX_TOKENS  optional
#   MODEL_<ROLE>_REASONING   optional: low|medium|high (reasoning models only)
#   MODEL_<ROLE>_REASONING_BODY  optional: raw JSON, overrides REASONING
#
# <ROLE> is the short prefix below (MODEL_COST_*). The full role name also
# works, e.g. MODEL_COST_OPTIMIZER_NAME is the same as MODEL_COST_NAME.
#
# REASONING maps onto each provider's own vocabulary:
#   openrouter -> {"reasoning": {"effort": "<level>"}}
#   nvidia     -> {"chat_template_kwargs": {"enable_thinking": true}}
#   larprouter -> nothing is sent; the upstream decides. Set REASONING_BODY
#                 if a particular route needs it.
#
# Note: reasoning tokens count against MAX_TOKENS - keep MAX_TOKENS comfortably
# above the reasoning budget or the visible output can come back empty.

# --- 1. Reorder Analyst : one agent per short SKU -------------------------
# deepseek-v4.1-flash and glm-5.3-flash are LarpRouter's free-tier routes.
MODEL_REORDER_PROVIDER=larprouter
MODEL_REORDER_NAME=deepseek-v4.1-flash
MODEL_REORDER_TEMPERATURE=0.1
MODEL_REORDER_MAX_TOKENS=

# --- 2. Supplier Scout : checks the DB for supplier offers -----------------
MODEL_SUPPLIER_PROVIDER=larprouter
MODEL_SUPPLIER_NAME=glm-5.3-flash
MODEL_SUPPLIER_TEMPERATURE=0.1
MODEL_SUPPLIER_MAX_TOKENS=

# --- 3. Cost Optimizer : landed cost and volume splits ----------------------
# For more reasoning headroom, swap in glm-5.3 ($0.03/$0.10 per 1M).
MODEL_COST_PROVIDER=larprouter
MODEL_COST_NAME=glm-5.3-flash
MODEL_COST_MAX_TOKENS=


# ===========================================================================
# Supplier quality floors
# ===========================================================================
# Objective rules, applied deterministically before the scout ranks what is
# left. A supplier that misses either floor is never considered, however cheap
# it is. Raise them for critical components, lower them for consumables.
MAX_DEFECT_RATE_PCT=5.0
MIN_ON_TIME_PCT=75.0


# ===========================================================================
# Optional OpenRouter attribution headers
# ===========================================================================
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=stock-reorder-agents


# ===========================================================================
# Observability
# ===========================================================================
# Every run writes runs/<REQ-....>.json (the trace log) and a row in
# runs/executions.csv (the executions table). dashboard.html is rebuilt from
# that table by `python main.py --dashboard`.

# The 3 documented alerts. A run whose slowest agent step, failure rate or
# estimated LLM cost exceeds its threshold triggers an alert notification.
ALERT_LATENCY_MS=30000
ALERT_FAILURE_RATE_PCT=20
ALERT_COST_LIMIT_USD=10

# Estimated price per MILLION tokens (input / output) for the cost alert.
# Leave 0 on free pools (LarpRouter) - cost then reads $0 and the cost alert
# stays quiet. Set real plan prices when you are on a paid gateway.
COST_INPUT_PER_MTOK=0
COST_OUTPUT_PER_MTOK=0

# Where the run logs, the executions table and dashboard.html live.
RUNS_DIR=runs

